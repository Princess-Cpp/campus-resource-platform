# Copy to .env and replace both values before `docker compose up -d mysql`.
# .env is ignored by Git; never commit real passwords.
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password

# scripts/dev*.sh read these from the shell environment, not from .env:
# MYSQL_DSN=campus:<MYSQL_PASSWORD>@tcp(127.0.0.1:3306)/campus?parseTime=true&multiStatements=true
# M1_CODE_SECRET=<at least 32 bytes; e.g. openssl rand -hex 32>
# M2_SERVICE_TOKEN=<at least 32 bytes; e.g. openssl rand -hex 32>
# AUTH_DEV_PASSWORD=<at least 10 bytes>
