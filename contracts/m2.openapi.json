        "summary": "运营权限下按场地范围聚合；批准决定在后续撤销后保留",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "roomId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "读取成功或动作已持久化；syncStatus 非 IDLE 不是最终成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "correlationId"
                  ],
                  "properties": {
                    "data": {
                      "type": "object"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "输入无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "身份无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "动作无权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "不可访问或不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "状态/版本/幂等/资源冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "依赖不可用；核对原请求",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreateApplication": {
        "type": "object",
        "required": [
          "roomId",
          "startAt",
          "endAt",
          "purpose",
          "attendees",
          "contactRef"
        ],
        "properties": {
          "roomId": {
            "type": "string"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "purpose": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "attendees": {
            "type": "integer",
            "minimum": 1
          },
          "contactRef": {
            "type": "string"
          }
        }
      },
      "Action": {
        "type": "object",
        "required": [
          "action",
          "expectedVersion"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT",
              "CANCEL",
              "TERMINATE"
            ]
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "comment": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "Retry": {
        "type": "object",
        "required": [
          "expectedVersion"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Application": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "status",
          "version",
          "syncStatus",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "roomName": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "deadlineAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "syncStatus": {
            "type": "string"
          },
          "operationId": {
            "type": "string"
          },
          "sourceVersion": {
            "type": "integer"
          },
          "lastError": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "correlationId"
        ],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              }
            }
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "capacity": {
            "type": "integer"
          },
          "openHour": {
            "type": "integer"
          },
          "closeHour": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
