            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "mine"
              ],
              "default": "mine"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "REPORTED",
                "ASSIGNED",
                "IN_PROGRESS",
                "AWAITING_ACCEPTANCE",
                "COMPLETED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "LIGHTING",
                "POWER",
                "FURNITURE",
                "DOOR_WINDOW",
                "OTHER"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "description": "Own records only, SQL-scoped before pagination. Stable createdAt DESC, id DESC. Dates use [from,to). Unknown or duplicate query parameters are rejected. Other views are not implemented."
      }
    },
