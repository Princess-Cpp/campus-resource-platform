  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "campus_session",
        "description": "Existing shared SQL-backed identity session. A service Bearer cannot act as a user."
      }
    },
    "schemas": {
      "Report": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 64,
            "description": "UTF-8 stable ID, at most 64 bytes"
          },
          "seatId": {
            "type": "string",
            "maxLength": 64
          },
          "category": {
            "type": "string",
            "enum": [
              "LIGHTING",
              "POWER",
              "FURNITURE",
              "DOOR_WINDOW",
              "OTHER"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "description": "Trimmed, counted as Unicode code points"
          },
          "severity": {
            "type": "string",
            "enum": [
              "NORMAL",
              "URGENT"
            ],
            "default": "NORMAL"
          }
        },
        "required": [
          "roomId",
          "category",
          "description"
        ],
        "additionalProperties": false
      },
      "Seat": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "seats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Seat"
            }
          }
        },
        "required": [
          "id",
          "name",
          "area",
          "status",
          "seats"
        ],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reporterId": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "roomName": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "seatId": {
            "type": "string"
          },
          "seatLabel": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "LIGHTING",
              "POWER",
              "FURNITURE",
              "DOOR_WINDOW",
              "OTHER"
            ]
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "NORMAL",
              "URGENT"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "REPORTED",
              "ASSIGNED",
              "IN_PROGRESS",
              "AWAITING_ACCEPTANCE",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "syncState": {
            "type": "string",
            "enum": [
              "IDLE",
              "PENDING",
              "UNKNOWN",
              "NEEDS_ATTENTION"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "reporterId",
          "roomId",
          "roomName",
          "area",
          "category",
          "description",
          "severity",
          "state",
          "syncState",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "Timeline": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "action",
          "text",
          "at"
        ],
        "additionalProperties": false
      },
      "Detail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reporterId": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "roomName": {
            "type": "string"
